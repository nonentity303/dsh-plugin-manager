{
  "name": "dsh-plugin-manager-pro",
  "version": "0.6.8",
  "description": "本地插件管理器：分类折叠（必要程度×来源）、更新源一键更新（npm/GitHub/插件超市）、浏览器下载优先、下载目录自动安装、插件市场（dshfind 精选目录）、README 简介提取、救砖与启动前自检；跨平台（Windows/macOS/Linux）",
  "author": "nonentity303",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonentity303/dsh-plugin-manager.git"
  },
  "homepage": "https://github.com/nonentity303/dsh-plugin-manager#readme",
  "bugs": {
    "url": "https://github.com/nonentity303/dsh-plugin-manager/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin-manager",
    "plugin-management",
    "dsh-plugin",
    "rescue"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./typert": {
      "default": "./lib/remote.js"
    },
    "./remote": {
      "default": "./lib/remote.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "pluginManager": {
      "group": "plugin-management"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  }
}
