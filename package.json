{
  "name": "dsh-drydock",
  "version": "1.1.0-rc.2",
  "description": "DSH 引擎船坞（drydock，原名 dsh-plugin-manager-pro）：引擎外灾备与坞修——引擎起不来时仍能独立救援（3081 兜底页 / 3082 守护 / 官方 dsh rescue profile 通道）、离线只读诊断报告、官方恢复后自愈、启动前自检；装完之后的事——本地插件管理器：分类折叠（核心组件/引擎内置组件/用户插件，跟随官方 PROTECTED_PLUGINS 与 HIDDEN_BUNDLES）、更新源一键更新（npm/GitHub/自定义镜像）、浏览器下载优先、下载目录自动安装、插件市场（ADP 精选目录）、README 简介提取；事务化卸载（备份→删除→校验→回滚）、操作历史一键撤销、场景方案、来源人工修正、依赖关系感知；独立救援工具链（3082 rescue-daemon / open-boot 浏览器触发自启 / dsh-boot 启动序列）；1.1.0 起支持 DSH 桌面版（按 profile 能力门控 + 分级授权：只做官方覆盖不到的引擎外灾备，不抢宿主生命周期）；跨平台（Windows/macOS/Linux）",
  "author": "nonentity303",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonentity303/dsh-drydock.git"
  },
  "homepage": "https://github.com/nonentity303/dsh-drydock#readme",
  "bugs": {
    "url": "https://github.com/nonentity303/dsh-drydock/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "dsh-drydock",
    "drydock",
    "plugin-management",
    "dsh-plugin",
    "rescue"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "packageManager": "npm@11.19.0",
  "bin": {
    "dsh-drydock": "bin/open-boot.mjs",
    "dsh-drydock-boot": "bin/dsh-boot.mjs",
    "dsh-drydock-rescue": "bin/rescue-daemon.mjs",
    "dsh-drydock-doctor": "bin/drydock-doctor.mjs",
    "dsh-pm-launcher": "bin/open-boot.mjs",
    "dsh-pm-boot": "bin/dsh-boot.mjs",
    "dsh-pm-rescue": "bin/rescue-daemon.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./typert": {
      "default": "./lib/remote.js"
    },
    "./remote": {
      "default": "./lib/remote.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./bin/*": "./bin/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.mjs",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.7-rc.2 <0.3.0-0"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node test-bundle.mjs && node test-render.mjs && node test-integration.mjs && node test-launcher.mjs && node test-ux.mjs && node test-downloader.mjs && node test-security-provenance.mjs && node test-capabilities.mjs && node test-origin.mjs && node test-cors.mjs && node test-diagnostics.mjs && node test-rescue-profile.mjs",
    "test:launcher": "node test-launcher.mjs",
    "test:strict": "node test-launcher.mjs --strict",
    "test:ux": "node test-ux.mjs",
    "test:downloader": "node test-downloader.mjs",
    "test:security": "node test-security-provenance.mjs",
    "test:capabilities": "node test-capabilities.mjs",
    "test:origin": "node test-origin.mjs",
    "test:cors": "node test-cors.mjs",
    "test:diagnostics": "node test-diagnostics.mjs",
    "test:rescue-profile": "node test-rescue-profile.mjs",
    "test:desktop": "node test-capabilities.mjs && node test-origin.mjs && node test-cors.mjs && node test-diagnostics.mjs && node test-rescue-profile.mjs",
    "check:vendor": "node tools/check-vendor.mjs",
    "pack": "node build.mjs && npm pack",
    "preflight": "node tools/dev/npm-preflight.mjs",
    "publish:npm": "node tools/dev/publish-npm.mjs",
    "publish:npm:apply": "node tools/dev/publish-npm.mjs --apply",
    "publish:webauth": "node tools/dev/publish-webauth.mjs",
    "publish:all": "node tools/dev/publish-all.mjs",
    "publish:status": "node tools/dev/publish-all.mjs --status",
    "verify:triple": "node tools/dev/verify-triple.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.7-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "esbuild": "^0.25.0",
    "jsdom": "^24.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dsh": {
    "pluginManager": {
      "group": "plugin-management"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway"
      ]
    }
  }
}
